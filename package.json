{
  "name": "atlasmerge",
  "private": true,
  "workspaces": ["apps/web"],
  "dependencies": {
    "next": "16.3.2"
  },
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build && node -e \"require('fs').cpSync('apps/web/.next','.next',{recursive:true})\"",
    "lint": "npm --prefix apps/web run lint",
    "typecheck": "npm --prefix apps/web run typecheck",
    "test": "npm --prefix apps/web run test"
  }
}
